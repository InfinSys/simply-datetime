gb(204, 204, 204));&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;/* (&lt;i&gt;should I ask for the calendar type as the template parameter instead?&lt;/i&gt;) */&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(204, 204, 204), rgb(204, 204, 204));&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(204, 204, 204), rgb(204, 204, 204));&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(204, 204, 204), rgb(204, 204, 204));&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;font style=&quot;color: light-dark(rgb(204, 204, 204), rgb(204, 204, 204));&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;/* (&lt;i&gt;no, ask for TargetDate_T and TargetTime_T then return an unnamed struct containing these types&lt;/i&gt;) */&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(204, 204, 204), rgb(204, 204, 204));&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(204, 204, 204), rgb(204, 204, 204));&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(204, 204, 204), rgb(204, 204, 204));&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(204, 204, 204), rgb(204, 204, 204));&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;font style=&quot;color: light-dark(rgb(204, 204, 204), rgb(204, 204, 204));&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;/* (&lt;i&gt;this class will also hold the logic to displace a Datetime with a duration&lt;/i&gt;) */&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;background-color: transparent; color: light-dark(rgb(255, 128, 0), rgb(255, 128, 0));&quot;&gt;}&lt;/font&gt;&lt;font style=&quot;background-color: transparent; color: light-dark(rgb(255, 255, 255), rgb(255, 255, 255));&quot;&gt;;&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="AAKn3JwIwb8s-OrhhNjA-1">
